# ClaveÚnica Multi-Environment Setup (Auto-Resolved based on hostname)
# You can override all environments by simply setting CLAVEUNICA_CLIENT_ID and CLAVEUNICA_CLIENT_SECRET.
CLAVEUNICA_ENVIRONMENT=sandbox  # Options: sandbox, qa, prod

# Sandbox / Testing (Default)
CLAVEUNICA_CLIENT_ID_SANDBOX=3e0bc6a2dbc84c459e570f94553ca2ce
CLAVEUNICA_CLIENT_SECRET_SANDBOX=4e61dbf4d6a647559825fa1952dac4ac

# QA Setup
CLAVEUNICA_CLIENT_ID_QA=2f0a7232fafb49ab81d6da0353de5ec1
CLAVEUNICA_CLIENT_SECRET_QA=4ed6976ec1e9427c857b182626b4a174

# Production Setup
CLAVEUNICA_CLIENT_ID_PROD=bf9ad98831964b68a82849cc2a82c2c9
CLAVEUNICA_CLIENT_SECRET_PROD=f9927df3428c4d34b05efb6f0d381f12

# Explicit Global Overrides (if set, these take priority)
CLAVEUNICA_CLIENT_ID=
CLAVEUNICA_CLIENT_SECRET=
CLAVEUNICA_REDIRECT_URI=

# Firebase Admin (Required for ClaveÚnica custom token creation)
# Obtain these from Firebase Console -> Project Settings -> Service Accounts
FIREBASE_PROJECT_ID=gen-lang-client-0065328631
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
