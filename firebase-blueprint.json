{
  "entities": {
    "Notificacion": {
      "title": "Notificación In-App",
      "description": "Notificación para usuarios sobre cambios de estado y acciones",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "usuarioUid": { "type": "string" },
        "titulo": { "type": "string" },
        "mensaje": { "type": "string" },
        "leida": { "type": "boolean" },
        "link": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "usuarioUid", "titulo", "mensaje", "leida", "createdAt"]
    },
    "User": {
      "title": "Usuario",
      "description": "Información del funcionario en el sistema",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "nombre": { "type": "string" },
        "rut": { "type": "string" },
        "email": { "type": "string" },
        "servicioId": { "type": "string" },
        "cargo": { "type": "string" },
        "grado": { "type": "string" },
        "ley": { "type": "string" },
        "planta": { "type": "string" },
        "genero": { "type": "string" },
        "rol": { "type": "string", "enum": ["Funcionario", "Jefatura de Servicio", "Director", "Personal", "Finanzas", "Administrador"] },
        "activo": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "nombre", "rut", "email", "servicioId", "cargo", "rol", "activo"]
    },
    "Servicio": {
      "title": "Servicio o Unidad",
      "description": "Servicios del Hospital de Curepto",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nombre": { "type": "string" },
        "jefaturaUid": { "type": "string" },
        "emailJefatura": { "type": "string" },
        "activo": { "type": "boolean" }
      },
      "required": ["id", "nombre", "activo"]
    },
    "Cometido": {
      "title": "Cometido Funcionario",
      "description": "Solicitud de cometido funcionario",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "funcionarioUid": { "type": "string" },
        "nombreFuncionario": { "type": "string" },
        "rut": { "type": "string" },
        "email": { "type": "string" },
        "servicioId": { "type": "string" },
        "servicioNombre": { "type": "string" },
        "cargo": { "type": "string" },
        "grado": { "type": "string" },
        "ley": { "type": "string" },
        "planta": { "type": "string" },
        "genero": { "type": "string" },
        "tipoCometido": { "type": "string", "enum": ["Reunión", "Traslado", "Capacitación", "Comisión de servicio", "Otro"] },
        "motivo": { "type": "string" },
        "destino": { "type": "string" },
        "ciudad": { "type": "string" },
        "region": { "type": "string" },
        "fechaInicio": { "type": "string" },
        "horaInicio": { "type": "string" },
        "fechaTermino": { "type": "string" },
        "horaTermino": { "type": "string" },
        "medioTransporte": { "type": "string", "enum": ["Vehículo institucional", "Vehículo particular", "Bus", "Otro"] },
        "requiereTraslado": { "type": "boolean" },
        "fueraDeCurepto": { "type": "boolean" },
        "posibleViatico": { "type": "string", "enum": ["Sí", "No", "Por evaluar"] },
        "estado": { "type": "string" },
        "observacionesFuncionario": { "type": "string" },
        "documentosAdjuntos": { "type": "array", "items": { "type": "string" } },
        "firmaFuncionario": { "type": "string" },
        "selloDigitalFuncionario": { "type": "string" },
        "jefaturaUid": { "type": "string" },
        "decisionJefatura": { "type": "string" },
        "fechaDecisionJefatura": { "type": "string" },
        "observacionJefatura": { "type": "string" },
        "firmaJefatura": { "type": "string" },
        "selloDigitalJefatura": { "type": "string" },
        "decisionDirector": { "type": "string" },
        "fechaDecisionDirector": { "type": "string" },
        "observacionDirector": { "type": "string" },
        "firmaDirector": { "type": "string" },
        "selloDigitalDirector": { "type": "string" },
        "revisionPersonal": { "type": "string" },
        "fechaRevisionPersonal": { "type": "string" },
        "resolucionAdministrativa": { "type": "string" },
        "observacionPersonal": { "type": "string" },
        "correspondeViatico": { "type": "boolean" },
        "montoEstimado": { "type": "number" },
        "montoPagado": { "type": "number" },
        "fechaPago": { "type": "string" },
        "medioPago": { "type": "string" },
        "comprobantePago": { "type": "string" },
        "observacionFinanzas": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "funcionarioUid", "estado", "createdAt"]
    },
    "Reemplazo": {
      "title": "Solicitud de Reemplazo",
      "description": "Solicitud de reemplazo de un funcionario",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "funcionarioReemplazoUid": { "type": "string" },
        "nombreFuncionario": { "type": "string" },
        "rutFuncionario": { "type": "string" },
        "cargoFuncionario": { "type": "string" },
        "gradoFuncionario": { "type": "string" },
        "leyFuncionario": { "type": "string" },
        "plantaFuncionario": { "type": "string" },
        "jefaturaUid": { "type": "string" },
        "nombreJefatura": { "type": "string" },
        "servicioId": { "type": "string" },
        "servicioNombre": { "type": "string" },
        "motivo": { "type": "string", "enum": ["Feriado legal", "Otro"] },
        "observacionMotivo": { "type": "string" },
        "nombreReemplazante": { "type": "string" },
        "rutReemplazante": { "type": "string" },
        "profesionReemplazante": { "type": "string" },
        "fechaInicio": { "type": "string" },
        "fechaTermino": { "type": "string" },
        "estado": { "type": "string" },
        "firmaJefatura": { "type": "string" },
        "selloDigitalJefatura": { "type": "string" },
        "decisionDirector": { "type": "string" },
        "fechaDecisionDirector": { "type": "string" },
        "observacionDirector": { "type": "string" },
        "firmaDirector": { "type": "string" },
        "selloDigitalDirector": { "type": "string" },
        "nombreDirector": { "type": "string" },
        "recepcionadoPersonal": { "type": "boolean" },
        "fechaRecepcionPersonal": { "type": "string" },
        "procesadoPersonal": { "type": "boolean" },
        "fechaProcesadoPersonal": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "funcionarioReemplazoUid", "jefaturaUid", "motivo", "estado", "createdAt"]
    },
    "HistorialCometido": {
      "title": "Historial de Cometido",
      "description": "Log de cambios para un cometido",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "cometidoId": { "type": "string" },
        "fecha": { "type": "string", "format": "date-time" },
        "usuarioUid": { "type": "string" },
        "usuarioNombre": { "type": "string" },
        "rol": { "type": "string" },
        "accion": { "type": "string" },
        "estadoAnterior": { "type": "string" },
        "estadoNuevo": { "type": "string" },
        "observacion": { "type": "string" }
      },
      "required": ["cometidoId", "fecha", "usuarioUid", "accion"]
    },
    "Counter": {
      "title": "Contador de Resoluciones",
      "description": "Contador para generar números de resolución automáticos",
      "type": "object",
      "properties": {
        "lastNumber": { "type": "number" },
        "year": { "type": "number" }
      },
      "required": ["lastNumber", "year"]
    },
    "ViaticoValue": {
      "title": "Valor de Viático",
      "description": "Valores de viáticos según tramo y fecha",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tramoGrado": { "type": "string" },
        "fechaInicio": { "type": "string" },
        "fechaTermino": { "type": "string" },
        "valor100": { "type": "number" },
        "valor40": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "tramoGrado", "fechaInicio", "valor100", "valor40"]
    }
  },
  "firestore": {
    "/users/{userId}": { "schema": "User", "description": "Perfiles de usuarios" },
    "/servicios/{servicioId}": { "schema": "Servicio", "description": "Servicios del hospital" },
    "/cometidos/{cometidoId}": { "schema": "Cometido", "description": "Solicitudes de cometidos" },
    "/historial_cometidos/{historialId}": { "schema": "HistorialCometido", "description": "Historial de cambios" },
    "/counters/{counterId}": { "schema": "Counter", "description": "Contadores secuenciales" },
    "/viaticos_valores/{viaticoId}": { "schema": "ViaticoValue", "description": "Valores de viáticos por tramo y período" },
    "/reemplazos/{reemplazoId}": { "schema": "Reemplazo", "description": "Solicitudes de reemplazo" },
    "/notificaciones/{notificacionId}": { "schema": "Notificacion", "description": "Notificaciones in-app" }
  }
}